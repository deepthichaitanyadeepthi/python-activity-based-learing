# Attendance Recovery Computation

attended = int(input("Enter classes attended: "))
total = int(input("Enter total classes conducted: "))
threshold = float(input("Enter eligibility percentage: "))

if total <= 0 or attended < 0 or attended > total:
    print("Invalid attendance details")

else:
    percentage = (attended / total) * 100
    print("Current Attendance:", round(percentage, 2), "%")

    if percentage >= threshold:
        print("You are eligible for exams")
        print("No extra classes required")

    else:
        extra = 0

        while ((attended + extra) / (total + extra)) * 100 < threshold:
            extra += 1

        print("Minimum extra classes required:", extra)
        print("Attendance after extra classes:",
              round((attended + extra) / (total + extra) * 100, 2), "%")